# ==============================================================================
# CSE Market Intelligence Platform - Production Git Ignore Configuration
# ==============================================================================

# Python Environments & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing, Coverage & Profiling
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Local Databases, Dumps & Temp Files
*.db
*.sqlite
*.sqlite3
*.duckdb
*.parquet.tmp
*.tmp
*.log
scratch/

# Raw annual bulk trade dumps (regenerable / archived)
data/raw/yearly/*.csv

# Environment Variables & Secret Files
.env
.env.local
.env.*.local
.env.production
.env.staging
!.env.example

# IDE, OS & Editor Metadata
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# MLflow Experiment Tracking
mlruns/
mlartifacts/
.mlflow/

# Frontend (React + Vite) Build & Dependencies
node_modules/
frontend-react/node_modules/
frontend-react/dist/
frontend-react/.vite/
frontend-react/.eslintcache
frontend-react/*.local

# Retain Critical Directories with .gitkeep
!.gitkeep
