# ==============================================================================
# CSE Market Intelligence Platform - Environment Configuration Template
# Copy this file to .env and configure your local/cloud credentials.
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO VERSION CONTROL.
# ==============================================================================

# Database Connection String (PostgreSQL / Supabase)
# For local Docker Compose Postgres:
DATABASE_URL=postgresql+psycopg2://cse_user:cse_password@localhost:5432/cse_db

# For Supabase Session/Transaction Pooler (Port 6543):
# DATABASE_URL=postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Backend API Serving Port (defaults to 8000)
PORT=8000

# Frontend API Endpoint
# Local Development:
VITE_API_URL=http://localhost:8000
# Production Cloud Serving (e.g. Render / Cloud Run):
# VITE_API_URL=https://cse-market-intelligence-api.onrender.com

# Python Module Search Path (required for local CLI execution)
PYTHONPATH=.
